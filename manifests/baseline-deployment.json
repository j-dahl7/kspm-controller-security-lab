{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "kspm-scope-proof",
    "namespace": "nls-kspm-controller-lab",
    "labels": {
      "app.kubernetes.io/name": "kspm-scope-proof",
      "app.kubernetes.io/part-of": "nls-kspm-controller-lab"
    }
  },
  "spec": {
    "replicas": 2,
    "revisionHistoryLimit": 2,
    "strategy": {
      "type": "RollingUpdate",
      "rollingUpdate": {
        "maxSurge": 0,
        "maxUnavailable": 1
      }
    },
    "selector": {
      "matchLabels": {
        "app.kubernetes.io/name": "kspm-scope-proof"
      }
    },
    "template": {
      "metadata": {
        "labels": {
          "app.kubernetes.io/name": "kspm-scope-proof",
          "app.kubernetes.io/part-of": "nls-kspm-controller-lab"
        }
      },
      "spec": {
        "automountServiceAccountToken": false,
        "securityContext": {
          "runAsNonRoot": true,
          "runAsUser": 65532,
          "runAsGroup": 65532,
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        },
        "containers": [
          {
            "name": "pause",
            "image": "registry.k8s.io/pause@sha256:278fb9dbcca9518083ad1e11276933a2e96f23de604a3a08cc3c80002767d24c",
            "imagePullPolicy": "IfNotPresent",
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "readOnlyRootFilesystem": false,
              "capabilities": {
                "drop": ["ALL"]
              }
            },
            "resources": {
              "requests": {
                "cpu": "10m",
                "memory": "16Mi"
              },
              "limits": {
                "cpu": "50m",
                "memory": "32Mi"
              }
            }
          }
        ]
      }
    }
  }
}
